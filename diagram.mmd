erDiagram

CUSTOMER ||--o{ ORDER : places
ORDER ||--|{ ORDER_ITEM : contains
PRODUCT ||--o{ ORDER_ITEM : ordered_as
CATEGORY ||--o{ PRODUCT : classifies
BRAND ||--o{ PRODUCT : manufactures
CUSTOMER ||--o| CART : has
CART ||--o{ CART_ITEM : contains
PRODUCT ||--o{ CART_ITEM : added_as
ORDER ||--o| PAYMENT : paid_via
ORDER ||--o| DELIVERY : shipped_via

CUSTOMER {
    uuid id PK
    string full_name
    string email
    string phone
    timestamp registered_at
}

ORDER {
    uuid id PK
    uuid customer_id FK
    string status
    decimal total_amount
    timestamp created_at
}

ORDER_ITEM {
    uuid id PK
    uuid order_id FK
    uuid product_id FK
    int quantity
    decimal unit_price
}

PRODUCT {
    uuid id PK
    uuid category_id FK
    uuid brand_id FK
    string sku
    string title
    decimal current_price
    int stock_quantity
}

CATEGORY {
    uuid id PK
    string name
    string slug
}

BRAND {
    uuid id PK
    string name
    string country
}

CART {
    uuid id PK
    uuid customer_id FK
    timestamp created_at
}

CART_ITEM {
    uuid id PK
    uuid cart_id FK
    uuid product_id FK
    int quantity
}

PAYMENT {
    uuid id PK
    uuid order_id FK
    string provider
    string status
    string transaction_id
    timestamp processed_at
}

DELIVERY {
    uuid id PK
    uuid order_id FK
    string city
    string branch_id
    string ttn
}